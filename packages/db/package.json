{
  "name": "@fury/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/index.ts",
    "generate": "drizzle-kit generate:pg",
    "migrate": "node --loader ts-node/esm src/migrate.ts",
    "studio": "drizzle-kit studio",
    "db:seed": "node --loader ts-node/esm src/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@fury/shared": "*",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.4"
  }
}
