# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
DATABASE_URL=postgresql://user:senha@ep-xxx.neon.tech/neondb
TEST_DATABASE_URL=postgresql://user:senha@ep-xxx-teste.neon.tech/neondb

# Redis
REDIS_URL=redis://default:senha@containers-us-west-xxx.railway.app:6379

# Autenticação
JWT_SECRET=troque_por_segredo_forte_aqui
JWT_REFRESH_SECRET=troque_por_outro_segredo_forte_aqui

# Meta Ads API
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
META_USE_MOCK=true

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI DALL-E 3
OPENAI_API_KEY=sua_chave_openai_aqui

# Asaas (Billing)
ASAAS_API_KEY=sua_chave_asaas_aqui
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=seu_webhook_token_aqui
