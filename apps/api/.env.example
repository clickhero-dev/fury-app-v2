# ============================================
# FURY API — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.

# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Banco de Dados ----
DATABASE_URL=
TEST_DATABASE_URL=

# ---- Redis ----
REDIS_URL=

# ---- JWT / Autenticação ----
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Meta Ads API ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_USE_MOCK=true
META_API_MOCK=true
META_SYSTEM_ACCESS_TOKEN=

# ---- Criptografia de Tokens Meta ----
TOKEN_ENCRYPTION_KEY=

# ---- Google Meu Negócio (Google Business Profile) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/auth/callback
GOOGLE_SOCIAL_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_SOCIAL_FRONTEND_URL=http://localhost:5173
GOOGLE_API_MOCK=true

# ---- LLMs (Inteligência Artificial) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- Billing (Asaas) ----
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# ---- Email (Resend) ----
RESEND_API_KEY=

# ---- URLs Públicas ----
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ---- PostHog (Analytics / Error Tracking / Session Replay) ----
POSTHOG_API_KEY=

# ---- Cloudflare R2 (Storage Persistente) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---- Observabilidade (Grafana OTel LGTM — traces/métricas/logs via OTLP) ----
# OTEL_ENABLED=true liga o SDK; OTEL_EXPORTER_OTLP_ENDPOINT é a base OTLP/HTTP
# (porta 4318) do collector. Só envia dados quando AMBAS as variáveis existem.
# OTEL_ENABLED=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://clickhero-grafana-otel-lgtm.u7pe19.easypanel.host:4318
# OTEL_SERVICE_NAME=fury-api
# OTEL_LOG_LEVEL=info
# GRAFANA_API_TOKEN= (service account p/ importar dashboards — não vai para o código)
