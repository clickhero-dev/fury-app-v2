# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados
DATABASE_URL=postgresql://user:senha@ep-xxx.neon.tech/neondb
TEST_DATABASE_URL=postgresql://user:senha@ep-xxx-teste.neon.tech/neondb

# Redis
REDIS_URL=redis://default:senha@containers-us-west-xxx.railway.app:6379

# Autenticação
JWT_SECRET=troque_por_segredo_forte_aqui
JWT_REFRESH_SECRET=troque_por_outro_segredo_forte_aqui

# Meta Ads API
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
META_USE_MOCK=true

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI DALL-E 3
OPENAI_API_KEY=sua_chave_openai_aqui

# Asaas (Billing)
ASAAS_API_KEY=sua_chave_asaas_aqui
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=seu_webhook_token_aqui

# Criptografia de tokens Meta (mínimo 32 caracteres aleatórios)
TOKEN_ENCRYPTION_KEY=

# OAuth Meta
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_PAGE_ID=
META_DEFAULT_LINK_URL=https://example.com

# Assets públicos
PUBLIC_BASE_URL=http://localhost:3000

# URLs de ambiente
APP_URL=https://fury-app-v2-production.up.railway.app
FRONTEND_URL=https://fury-app-v2-web.vercel.app

# CORS (lista de origens separada por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Bypass de autenticação — APENAS desenvolvimento local (nunca ativar em produção)
AUTH_BYPASS_DEV=false

# DeepSeek — LLM principal do Estúdio Criativo (compatível com API OpenAI)
DEEPSEEK_API_KEY=

# Puppeteer — renderização HTML→PNG do Estúdio Criativo
# No Railway (Linux/Nixpacks) o Chromium é instalado via apt — use estas variáveis
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
