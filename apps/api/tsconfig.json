{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "module": "ES2022",
    "target": "ES2020",
    "jsx": "react-jsx",
    "paths": {
      "@fury/shared": ["../../packages/shared/dist/index.d.ts"],
      "@fury/db": ["../../packages/db/dist/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "test-wizard-mocked.ts"
  ]
}