# ============================================
# FURY Platform — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# As variáveis marcadas com (opcional) têm fallback no código
# e podem ser deixadas em branco.
# ============================================

# ---- Servidor ----
PORT=3000
NODE_ENV=development

# ---- Banco de Dados ----
DATABASE_URL=postgresql://fury:fury_local@localhost:5432/fury_dev
TEST_DATABASE_URL=postgresql://fury:fury_local@localhost:5432/fury_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT / Autenticação ----
JWT_SECRET=troque_por_segredo_forte_min_32_caracteres
JWT_REFRESH_SECRET=troque_por_outro_segredo_forte_min_32_caracteres
JWT_EXPIRES_IN=15m           # (opcional) padrão 15m
JWT_REFRESH_EXPIRES_IN=7d     # (opcional) padrão 7d
AUTH_BYPASS_DEV=false         # (opcional) APENAS dev local! Nunca true em produção

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174   # (opcional)

# ---- Meta Ads API ----
META_APP_ID=seu_app_id_aqui
META_APP_SECRET=seu_app_secret_aqui
META_PAGE_ID=                        # (opcional) ID da página para anúncios
META_DEFAULT_LINK_URL=https://example.com   # (opcional) link padrão nos anúncios
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_USE_MOCK=true                   # (opcional) usar mock em dev
META_API_MOCK=true                   # (opcional) mock da camada HTTP do Meta

# ---- Criptografia de Tokens Meta ----
TOKEN_ENCRYPTION_KEY=                # mínimo 32 caracteres aleatórios

# ---- LLMs (Inteligência Artificial) ----
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sua_chave_openai_aqui
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ---- Billing (Asaas) ----
ASAAS_API_KEY=sua_chave_asaas_aqui
ASAAS_ENV=sandbox                    # sandbox | production
ASAAS_WEBHOOK_TOKEN=seu_webhook_token_aqui

# ---- URLs Públicas ----
PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ---- Estúdio Criativo ----
STUDIO_ASSETS_DIR=/tmp/studio-assets   # (opcional) diretório para imagens temporárias

# ---- Cloudflare R2 (Storage Persistente) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---- Frontend (Vite) ----
VITE_API_URL=http://localhost:3000/api

# ---- Docker (Infra Local) ----
POSTGRES_DB=fury_dev
POSTGRES_USER=fury
POSTGRES_PASSWORD=fury_local
POSTGRES_PORT=5432
REDIS_PORT=6379
