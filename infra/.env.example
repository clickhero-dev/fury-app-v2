# Database
POSTGRES_DB=fury_dev
POSTGRES_USER=fury
POSTGRES_PASSWORD=fury_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fury:fury_local@localhost:5432/fury_dev
TEST_DATABASE_URL=postgresql://fury:fury_local@localhost:5432/fury_test

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_required
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars

# Meta Ads API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Server
PORT=3000
NODE_ENV=development
