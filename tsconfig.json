{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@fury/shared": ["packages/shared/src/index.ts"],
      "@fury/shared/*": ["packages/shared/src/*"],
      "@fury/db": ["packages/db/src/index.ts"],
      "@fury/db/*": ["packages/db/src/*"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist", "apps/**"]
}
