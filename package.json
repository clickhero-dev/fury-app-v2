{
  "name": "fury",
  "version": "0.1.0",
  "private": true,
  "description": "FURY - Paid Traffic Automation Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces --if-present dev",
    "build": "npm run build --workspace=@fury/shared && npm run build --workspace=@fury/db && npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "db:migrate": "npm run --workspace @fury/db migrate",
    "db:studio": "npm run --workspace @fury/db studio",
    "db:seed": "npm run db:seed --workspace=@fury/db",
    "test": "vitest run",
    "test:dev": "vitest run apps/api",
    "test:prod": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run apps/api/src/__tests__/billing-subscription.test.ts apps/api/src/__tests__/campaigns-create.unit.test.ts apps/api/src/__tests__/campaigns-service.test.ts apps/api/src/__tests__/date-sao-paulo.test.ts apps/api/src/__tests__/jwt.test.ts apps/api/src/__tests__/meta-conversion-events.test.ts apps/api/src/__tests__/meta-insights-parser.test.ts apps/api/src/__tests__/metrics-formatter.test.ts apps/api/src/__tests__/rate-limit.test.ts apps/api/src/__tests__/sanitize-log-data.test.ts apps/api/src/__tests__/sse.test.ts apps/api/src/__tests__/studio-copy-simple.test.ts apps/api/src/__tests__/studio-copy-validate.test.ts",
    "qa:audit": "bash scripts/coverage-audit.sh",
    "security:audit": "bash scripts/security-audit.sh",
    "security:audit:json": "bash scripts/security-audit.sh --json"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "esbuild": "0.28.0",
    "nodemailer": "^9.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.0",
    "lightningcss-darwin-arm64": "^1.32.0",
    "lightningcss-darwin-x64": "^1.32.0",
    "lightningcss-linux-arm64-gnu": "^1.32.0",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
