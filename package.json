{
  "name": "fury",
  "version": "0.1.0",
  "private": true,
  "description": "FURY - Paid Traffic Automation Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces --if-present dev",
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "db:migrate": "npm run --workspace @fury/db migrate",
    "db:studio": "npm run --workspace @fury/db studio",
    "db:seed": "npm run db:seed --workspace=@fury/db",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "recharts": "^3.8.1"
  }
}
