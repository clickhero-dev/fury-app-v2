{
  "name": "fury",
  "version": "0.1.0",
  "private": true,
  "description": "FURY - Paid Traffic Automation Platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspaces --if-present dev",
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "db:migrate": "npm run --workspace @fury/db migrate",
    "db:studio": "npm run --workspace @fury/db studio",
    "db:seed": "npm run db:seed --workspace=@fury/db",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.40.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "dotenv": "^17.4.2"
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
